 % Yours sincerely,
 % Ilya Kuprov.
 
+% Octave port (BasisREMY): struct-of-arrays replacement for the MATLAB table
+function D=descr_pack(varargin)
+names=varargin{end}; vals=varargin(1:(end-2)); D=struct();
+for k=1:numel(names), D.(names{k})=vals{k}; end
+end
+function D=descr_rows(D,idx)
+f=fieldnames(D);
+for k=1:numel(f), D.(f{k})=D.(f{k})(idx,:); end
+end
+function D=descr_cat(D1,D2)
+f=fieldnames(D1); D=struct();
+for k=1:numel(f), D.(f{k})=[D1.(f{k}); D2.(f{k})]; end
+end
